{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClassAegisService",
  "version": "0.1.2",
  "identifier": "io.github.classaegis.service",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "ClassAegisService",
      "width": 980,
      "height": 660,
      "minWidth": 820,
      "minHeight": 560,
      "decorations": false,
      "resizable": true,
      "maximizable": false,
      "fullscreen": false,
      "center": true,
      "visible": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:39817; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "resources": {
      "../build/stage/bin/": "bin/",
      "../build/stage/conf/": "conf/"
    }
  }
}
