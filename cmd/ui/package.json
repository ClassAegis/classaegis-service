{
  "name": "classaegis-service-ui",
  "version": "0.1.0",
  "private": true,
  "description": "ClassAegisService desktop service",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File build/tauri-service.ps1 -Dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File build/tauri-service.ps1",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File build/build-service.ps1",
    "dist:service": "powershell -NoProfile -ExecutionPolicy Bypass -File build/build-service.ps1"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^5.0.5",
    "element-plus": "^2.7.8",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.4"
  }
}
